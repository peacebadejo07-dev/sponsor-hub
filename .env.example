# Local development uses the embedded Postgres started by `npm run db:start`.
DATABASE_URL=postgres://postgres:postgres@localhost:54329/sponsored
# Production: use your Supabase connection string (transaction pooler).

# Optional: free Companies House API key (https://developer.company-information.service.gov.uk/).
# Enables company number, incorporation date and SIC-code based sector tags in `npm run resolve`.
COMPANIES_HOUSE_API_KEY=
# Contact URL included in the resolver's User-Agent so site owners can reach you.
BOT_CONTACT=https://github.com/OWNER/sponsor-hub

# --- Accounts (required in production; the app refuses to start sign-in without them) ---
# Random string, 32+ characters. Generate one with:  openssl rand -base64 48
AUTH_SECRET=
# Public address of the site, used to build sign-in links. Never derived from the request.
PUBLIC_BASE_URL=
# Email delivery through Resend (https://resend.com, free tier). In development the sign-in link is printed to the server console instead.
RESEND_API_KEY=
AUTH_FROM=Sponsor Hub <signin@your-domain>
# Hosted Postgres connection string (Supabase pooler). TLS is required in production.
# DATABASE_URL=
