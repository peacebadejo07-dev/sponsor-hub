{
  // Cloudflare Workers with static assets (free plan). `npm run build` produces the worker in .svelte-kit/cloudflare.
  "name": "sponsor-hub",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-09-01",
  // nodejs_compat provides node:crypto (hashing, HMAC, random tokens) and the socket support the Postgres driver needs.
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "binding": "ASSETS", "directory": ".svelte-kit/cloudflare" },
  // Non-secret settings. Secrets (DATABASE_URL, AUTH_SECRET, RESEND_API_KEY) are set with `wrangler secret put`, never here.
  "vars": { "PUBLIC_BASE_URL": "https://sponsorhub.uk" },
  // Serve the site on the domain (Cloudflare creates the DNS record and certificate; the zone must be on this account).
  "routes": [{ "pattern": "sponsorhub.uk", "custom_domain": true }, { "pattern": "www.sponsorhub.uk", "custom_domain": true }],
  // Cloudflare Hyperdrive in front of Supabase (see DEPLOY.md): handles TLS to the database and pools connections.
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "6843bb69517b4c5d8273de3752ef065e" }],
  "observability": { "enabled": true }
}
