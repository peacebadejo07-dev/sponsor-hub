{
  // Cloudflare Workers with static assets (free plan). `npm run build` produces the worker in .svelte-kit/cloudflare.
  "name": "sponsor-hub",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-09-01",
  // nodejs_compat provides node:crypto (hashing, HMAC, random tokens) and the socket support the Postgres driver needs.
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "binding": "ASSETS", "directory": ".svelte-kit/cloudflare" },
  "observability": { "enabled": true }
}
